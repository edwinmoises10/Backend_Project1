<div>
    <h1>Lista de Productos</h1>
    <ul>
        {{#each products}}
        <li>
            <strong>{{this.title}}</strong> - ${{this.price}} 
            <button>Agregar al Carrito</button>
        </li>
        {{/each}}
    </ul>

    <hr>

    <div class="pagination">
        {{#if hasPrevPage}}
            <a href="/products?page={{prevPage}}&limit=4">⬅️ Anterior</a>
        {{/if}}

        <span> Página {{page}} de {{totalPages}} </span>

        {{#if hasNextPage}}
            <a href="/products?page={{nextPage}}&limit=4">Siguiente ➡️</a>
        {{/if}}
    </div>
</div>

<style>
    .pagination {
        margin-top: 20px;
        display: flex;
        gap: 15px;
        align-items: center;
    }
    a {
        text-decoration: none;
        padding: 5px 10px;
        border: 1px solid #000;
        background: #f0f0f0;
        color: black;
    }
</style>