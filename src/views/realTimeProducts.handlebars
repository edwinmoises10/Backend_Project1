<script src="/socket.io/socket.io.js"></script>
<script src="/client.socket.js"></script>

<div class="form-container">
  <h1 class="form-title">Real Time Product Manager</h1>

  <h2 id="textFromServer"></h2>

  <table class="table-container">

    <thead class="thead">
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Code</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Category</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody id="table">
      {{#if products.length}}
        {{#each products}}
          <tr>
            <td>{{this.id}}</td>
            <td>{{this.title}}</td>
            <td>{{this.code}}</td>
            <td>{{this.price}}</td>
            <td>{{this.stock}}</td>
            <td>{{this.category}}</td>
            <td>{{this.description}}</td>
          </tr>
        {{/each}}
      {{else}}
        <tr>
          <td colspan="7" style="text-align: center;">No hay productos
            registrados en este momento.</td>
        </tr>
      {{/if}}

    </tbody>

  </table>

</div>

<style>
  :root {
    --primary-color: #2f8470;
    --font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  }

  :root {
    --primary-color: #2563eb; /* Azul corporativo */
    --bg-header: #f8fafc; /* Fondo sutil para el thead */
    --text-main: #1e293b; /* Gris oscuro para legibilidad */
    --border-color: #e2e8f0; /* Bordes suaves */
    --row-hover: #f1f5f9; /* Efecto feedback */
  }

  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin: 25px 0;
    font-size: 0.9rem;
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      sans-serif;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    border-radius: 8px;
    overflow: hidden; /* Para que el border-radius afecte a las filas */
  }

  .thead tr {
    background-color: var(--bg-header);
    color: var(--text-main);
    text-align: left;
    border-bottom: 2px solid var(--border-color);
  }

  .table-container th,
  .table-container td {
    justify-content: center;
    padding: 12px 15px;
    border-bottom: 1px solid var(--border-color);
  }

  /* Estilo específico para los encabezados */
  .table-container th {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Filas alternas para evitar fatiga visual en tablas largas */
  .table-container tbody tr:nth-of-type(even) {
    background-color: #fafafa;
  }

  /* Feedback visual al pasar el cursor */
  .table-container tbody tr:hover {
    background-color: var(--row-hover);
    transition: background-color 0.2s ease;
  }

  .form-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
    font-family: var(--font-family);
  }
  .form-title {
    color: var(--primary-color);
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }
</style>

